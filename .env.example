# Copy to .env and adjust. .env is git-ignored; never commit real values.
# src/ExamForge.Api/appsettings.Development.json has a connection string built from these
# placeholders, so a fresh clone runs as-is. If you change them, override that connection
# string with user-secrets or the ConnectionStrings__ExamForge environment variable.
POSTGRES_USER=examforge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=examforge
POSTGRES_PORT=5432
